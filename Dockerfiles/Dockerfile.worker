FROM oven/bun:1.3.1 AS deps
RUN apt-get update -y && apt-get install -y openssl

WORKDIR /app

COPY package.json bun.lock turbo.json ./
COPY packages/redis-stream/package.json   ./packages/redis-stream/
COPY packages/db/package.json             ./packages/db/
COPY apps/evaluator/package.json          ./apps/evaluator/
COPY apps/worker/package.json             ./apps/worker/

RUN bun install

FROM oven/bun:1.3.1 AS builder
RUN apt-get update -y && apt-get install -y openssl

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules

COPY turbo.json package.json bun.lock ./
COPY packages/redis-stream ./packages/redis-stream
COPY packages/db           ./packages/db
COPY apps/evaluator        ./apps/evaluator
COPY apps/worker           ./apps/worker

RUN cd packages/db && bun run prisma:generate

FROM oven/bun:1.3.1-slim AS release
RUN apt-get update -y && apt-get install -y openssl

RUN groupadd -r appgroup && useradd -r -g appgroup appuser

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder --chown=appuser:appgroup /app/node_modules       ./node_modules
COPY --from=builder --chown=appuser:appgroup /app/packages           ./packages
COPY --from=builder --chown=appuser:appgroup /app/apps/evaluator     ./apps/evaluator
COPY --from=builder --chown=appuser:appgroup /app/apps/worker        ./apps/worker
COPY --from=builder --chown=appuser:appgroup /app/package.json       ./package.json
COPY --from=builder --chown=appuser:appgroup /app/turbo.json         ./turbo.json

USER appuser

WORKDIR /app/apps/worker

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD bun --version || exit 1

CMD ["bun", "run", "start:worker"]